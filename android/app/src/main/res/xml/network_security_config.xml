<?xml version="1.0" encoding="utf-8"?>
<!--
    Начиная с Android 9 (API 28) обычный HTTP (без TLS) заблокирован по умолчанию —
    это правильно для боевого сервера, но пока у бэкенда на VPS нет домена/HTTPS
    (фаза 6, см. claude/plan.md), приложение ходит на него обычным HTTP по IP.

    Здесь мы точечно разрешаем cleartext (нешифрованный) трафик только для этого
    одного IP-адреса — 185.122.184.92 (см. ApiConfig.kt) — а не для всего
    приложения. 127.0.0.1 оставлен на случай возврата к локальной разработке
    через эмулятор + `adb reverse`. Когда у бэкенда появится домен с HTTPS, весь
    этот файл можно будет удалить вместе со ссылкой на него в AndroidManifest.xml.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">185.122.184.92</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
